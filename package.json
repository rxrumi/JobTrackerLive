{
  "name": "job-tracker",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Sohaib Kazmi",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "scan": "wrangler tail --format pretty",
    "build:frontend": "node scripts/split-frontend.mjs",
    "test": "node --test",
    "test:migrations": "sh scripts/test-migrations.sh",
    "check:types": "wrangler types .wrangler/worker-runtime.d.ts --include-env=false && wrangler types --check --include-runtime=false",
    "check:deploy": "wrangler deploy --dry-run && wrangler deploy --dry-run -c workflow/wrangler.toml",
    "verify": "npm run build:frontend && npm audit && npm test && npm run test:migrations && npm run check:types && npm run check:deploy"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.1",
    "docx": "9.9.0",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1"
  }
}
